# =============================================
# BILLING PLATFORM - Environment Variables
# COPIAR A .env Y CONFIGURAR — NUNCA COMMITEAR .env
# =============================================

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billing_dev
DB_USERNAME=billing_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT — MUST be Base64-encoded, min 256 bits
# Generar con: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_SECRET_KEY_MIN_256_BITS

# Token expiration
JWT_ACCESS_EXPIRATION=900000     # 15 minutes
JWT_REFRESH_EXPIRATION=604800000 # 7 days

# CORS
CORS_ORIGINS=http://localhost:4200

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourcompany.com
MAIL_PASSWORD=CHANGE_ME

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=4200

# PgAdmin (solo dev)
PGADMIN_EMAIL=admin@billing.local
PGADMIN_PASSWORD=CHANGE_ME